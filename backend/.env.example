# Copia este archivo como .env (NO subir .env a GitHub)

# Local: External Database URL de Render  |  Producción: Internal Database URL
DATABASE_URL=postgresql://usuario:password@host:5432/taskboard_db

# Local con URL externa: true  |  Producción con URL interna: false
DB_SSL=true

# Local: URL de Vite  |  Producción: URL del Static Site (sin barra final)
FRONTEND_URL=http://localhost:5173

PORT=3000
